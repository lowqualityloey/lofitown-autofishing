{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "types.d.ts",
    "layout.js",
    "session.js",
    "panel.js",
    "autofish.js",
    "fishserve.js",
    "build-userscript.js",
    "scripts/**/*.js"
  ],
  "exclude": ["dist", "data", "shots", ".tmp", ".promptkit", ".pkab"]
}
